---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
}

const { title = "Evan | UBC Engineering Physics" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
    <!-- High-Legibility Technical Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- KaTeX CSS for LaTeX Math Rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">
    
		<title>{title}</title>
	</head>
	<body class="bg-nasa-bg text-nasa-white font-mono min-h-screen selection:bg-nasa-cyan/30 selection:text-white relative">
    <!-- Subtle CRT Scanlines (non-intrusive) -->
    <div class="fixed inset-0 crt-scanlines pointer-events-none z-50 opacity-20"></div>
    
		<slot />
	</body>
</html>
